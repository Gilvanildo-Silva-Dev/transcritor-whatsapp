# Copie este exemplo para .env.local somente se o arquivo local ainda não existir.
# Preencha a chave apenas no servidor; nunca use NEXT_PUBLIC_.
OPENAI_API_KEY=

# Opcional: fallback quando a API rejeitar formato/codec.
# OPUS em contêiner Ogg é enviado diretamente, sem conversão.
# Se vazio, o servidor procura ffmpeg no PATH.
FFMPEG_PATH=

# Motor gratuito local (opcional; os caminhos padrao funcionam sem preencher).
LOCAL_PYTHON_PATH=
LOCAL_MODEL_PATH=
